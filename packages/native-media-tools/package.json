{
  "name": "dsh-native-media-tools",
  "version": "0.1.0",
  "description": "DeepSeek Harness native audio/video cards plus xAI API TTS, STT, and sampled long-video understanding.",
  "repository": { "type": "git", "url": "git+https://github.com/xisheng687/dsh-subscription-media-suite.git", "directory": "packages/native-media-tools" },
  "homepage": "https://github.com/xisheng687/dsh-subscription-media-suite#readme",
  "keywords": ["deepseek-harness", "dsh-plugin", "audio", "video", "multimodal"],
  "publishConfig": { "access": "public" },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "media-proxy.js",
    "video-analysis.js",
    "cordis.patch.yml",
    "README.md",
    "NOTICE.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-user-questions": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.7",
    "react": "^18.2.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  }
}
